{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "WebSocket": {
    "KeepAliveIntervalSeconds": 30,
    "ReceiveBufferBytes": 4096,
    "MaxMessageBytes": 65536
  }
}
